{
    "name": "atom/di-lab",
    "type": "project",
    "description": "Standalone development and resolution checks for Atom DI",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/di",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/di": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/di": "^0.1@dev"
    },
    "autoload": {
        "psr-4": {
            "DiLab\\": "app/"
        }
    },
    "scripts": {
        "check": "@php check.php"
    }
}
