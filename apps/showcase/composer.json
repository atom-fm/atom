{
    "name": "atom/showcase",
    "type": "project",
    "description": "Atom component showcase",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/lucide",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/lucide": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "^0.1",
        "atom-fm/lucide": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Showcase\\": "app/"
        }
    }
}
