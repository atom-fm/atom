{
    "name": "atom/view-lab",
    "type": "project",
    "description": "Standalone development and rendering checks for Atom View",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/view",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/view": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/view": "^0.1@dev"
    },
    "autoload": {
        "psr-4": {
            "ViewLab\\": "app/"
        }
    },
    "scripts": {
        "check": "@php check.php"
    }
}
