{
    "name": "atom/pokedex",
    "type": "project",
    "description": "Pokédex and team builder example for Atom",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "dev-master"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
