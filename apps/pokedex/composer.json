{
    "name": "atom/pokedex",
    "type": "project",
    "description": "Pok\u00e9dex and team builder example for Atom",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "0.2.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/components",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/components": "0.2.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/validation",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/validation": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/view",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/view": "0.1.x-dev"
                },
                "reference": "none"
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "^0.2",
        "atom-fm/orm": "^0.1",
        "atom-fm/components": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
