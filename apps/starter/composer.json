{
    "name": "atom-fm/starter",
    "type": "project",
    "description": "A minimal Atom application with SQLite and Accounts",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "0.2.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/database",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/database": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/validation",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/validation": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/view",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/view": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/di",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/di": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/profiler",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/profiler": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/mail",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/mail": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../../packages/console",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/console": "0.1.x-dev"
                },
                "reference": "none"
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "^0.2",
        "atom-fm/database": "^0.1",
        "league/commonmark": "^2.9",
        "symfony/yaml": "^7.3 || ^8.0",
        "phiki/phiki": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    }
}
