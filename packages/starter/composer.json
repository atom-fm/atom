{
    "name": "atom/starter",
    "type": "project",
    "description": "A minimal Atom application with SQLite and Accounts",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "type": "path",
        "url": "../framework",
        "options": {"symlink": true, "versions": {"atom/framework": "dev-master"}}
    }],
    "require": {"php": "^8.4", "atom/framework": "dev-master"},
    "autoload": {"psr-4": {"App\\": "app/"}}
}
