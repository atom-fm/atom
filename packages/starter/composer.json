{
    "name": "atom-fm/starter",
    "type": "project",
    "description": "A minimal Atom application with SQLite and Accounts",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "type": "path",
        "url": "../framework",
        "options": {"symlink": true, "versions": {"atom-fm/framework": "dev-master"}}
    }],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "dev-master",
        "league/commonmark": "^2.9",
        "symfony/yaml": "^7.3 || ^8.0",
        "phiki/phiki": "^2.2"
    },
    "autoload": {"psr-4": {"App\\": "app/"}}
}
