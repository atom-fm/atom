{
    "name": "atom-fm/components",
    "type": "library",
    "description": "Server-rendered UI components for Atom Framework",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "0.2.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../validation",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/validation": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../view",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/view": "0.1.x-dev"
                },
                "reference": "none"
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Atom\\Components\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atom\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.2.x-dev"
        }
    }
}
