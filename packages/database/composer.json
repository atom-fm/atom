{
    "name": "atom-fm/database",
    "description": "PDO drivers, schema tools, and migrations for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "atom-fm/orm": "^0.1",
        "atom-fm/sql": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Atom\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atom\\Tests\\Database\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        }
    ]
}
