{
    "name": "atom-fm/lucide",
    "type": "library",
    "description": "Lucide icon resolver for Atom Framework",
    "license": ["MIT", "ISC"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/framework": "dev-master"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atom-fm/framework": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Atom\\Lucide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atom\\Lucide\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
