{
    "name": "atom-fm/framework",
    "type": "library",
    "description": "Atom Framework",
    "keywords": [
        "framework",
        "Atom"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "atom-fm/mail": "^0.1",
        "atom-fm/console": "^0.1",
        "dragonmantank/cron-expression": "^3.6",
        "atom-fm/validation": "^0.1",
        "atom-fm/view": "^0.1",
        "atom-fm/di": "^0.1",
        "atom-fm/profiler": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "phpbench/phpbench": "~1.4.0",
        "atom-fm/database": "^0.1",
        "atom-fm/sql": "^0.1",
        "atom-fm/orm": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Atom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atom\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../sql",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/sql": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../orm",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/orm": "dev-master"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../database",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/database": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../validation",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/validation": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../view",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/view": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../di",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/di": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../profiler",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/profiler": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../mail",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/mail": "0.1.x-dev"
                },
                "reference": "none"
            }
        },
        {
            "type": "path",
            "url": "../console",
            "options": {
                "symlink": true,
                "versions": {
                    "atom-fm/console": "0.1.x-dev"
                },
                "reference": "none"
            }
        }
    ],
    "suggest": {
        "atom-fm/database": "Enables Atom database services and migrations. Installs ORM and SQL."
    }
}
