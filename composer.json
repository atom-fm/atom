{
    "name": "atom/monorepo",
    "type": "project",
    "description": "Development workspace for the Atom framework, packages, and applications",
    "license": "MIT",
    "scripts": {
        "install:sql": "composer --working-dir=packages/sql install",
        "install:orm": "composer --working-dir=packages/orm install",
        "install:database": "composer --working-dir=packages/database install",
        "install:validation": "composer --working-dir=packages/validation install",
        "install:view": "composer --working-dir=packages/view install",
        "install:di": "composer --working-dir=packages/di install",
        "install:profiler": "composer --working-dir=packages/profiler install",
        "install:console": "composer --working-dir=packages/console install",
        "install:mail": "composer --working-dir=packages/mail install",
        "install:framework": "composer --working-dir=packages/framework install",
        "install:components": "composer --working-dir=packages/components install",
        "install:lucide": "composer --working-dir=packages/lucide install",
        "install:starter": "composer --working-dir=apps/starter install",
        "install:sample": "composer --working-dir=apps/sample install",
        "install:showcase": "composer --working-dir=apps/showcase install",
        "install:pokedex": "composer --working-dir=apps/pokedex install",
        "setup": [
            "@install:sql",
            "@install:orm",
            "@install:database",
            "@install:validation",
            "@install:view",
            "@install:di",
            "@install:profiler",
            "@install:console",
            "@install:mail",
            "@install:framework",
            "@install:components",
            "@install:lucide",
            "@install:starter",
            "@install:sample",
            "@install:showcase",
            "@install:pokedex"
        ],
        "sql:check": "composer --working-dir=packages/sql check",
        "orm:check": "composer --working-dir=packages/orm check",
        "database:check": "composer --working-dir=packages/database check",
        "validation:check": "composer --working-dir=packages/validation check",
        "view:check": "composer --working-dir=packages/view check",
        "di:check": "composer --working-dir=packages/di check",
        "profiler:check": "composer --working-dir=packages/profiler check",
        "console:check": "composer --working-dir=packages/console check",
        "mail:check": "composer --working-dir=packages/mail check",
        "framework:check": "composer --working-dir=packages/framework check",
        "components:check": "composer --working-dir=packages/components check",
        "lucide:test": "composer --working-dir=packages/lucide test",
        "sql:validate": "composer --working-dir=packages/sql validate --strict",
        "orm:validate": "composer --working-dir=packages/orm validate --strict",
        "database:validate": "composer --working-dir=packages/database validate --strict",
        "validation:validate": "composer --working-dir=packages/validation validate --strict",
        "view:validate": "composer --working-dir=packages/view validate --strict",
        "di:validate": "composer --working-dir=packages/di validate --strict",
        "profiler:validate": "composer --working-dir=packages/profiler validate --strict",
        "console:validate": "composer --working-dir=packages/console validate --strict",
        "mail:validate": "composer --working-dir=packages/mail validate --strict",
        "framework:validate": "composer --working-dir=packages/framework validate --strict",
        "components:validate": "composer --working-dir=packages/components validate --strict",
        "starter:validate": "composer --working-dir=apps/starter validate --strict",
        "lucide:validate": "composer --working-dir=packages/lucide validate --strict",
        "sample:validate": "composer --working-dir=apps/sample validate --strict",
        "showcase:validate": "composer --working-dir=apps/showcase validate --strict",
        "pokedex:validate": "composer --working-dir=apps/pokedex validate --strict",
        "validate:packages": [
            "@sql:validate",
            "@orm:validate",
            "@database:validate",
            "@validation:validate",
            "@view:validate",
            "@di:validate",
            "@profiler:validate",
            "@console:validate",
            "@mail:validate",
            "@framework:validate",
            "@components:validate",
            "@lucide:validate",
            "@starter:validate",
            "@sample:validate",
            "@showcase:validate",
            "@pokedex:validate"
        ],
        "check": [
            "@sql:check",
            "@orm:check",
            "@database:check",
            "@validation:check",
            "@view:check",
            "@di:check",
            "@profiler:check",
            "@console:check",
            "@mail:check",
            "@framework:check",
            "@components:check",
            "@lucide:test",
            "@validate:packages"
        ]
    }
}
